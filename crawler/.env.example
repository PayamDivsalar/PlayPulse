# Local venv / host-side crawler only (NOT used by docker-compose for the
# crawler container). Inside Docker, connection hosts are set in
# docker-compose.yml `environment:` because hostnames differ.
# See docs/setup.md.

# Required connection settings for host/venv runs:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_API_BASE_URL=http://127.0.0.1:8000

# Optional tunables default inside ``Settings`` / ``load_settings()``
# (crawler/config.py). Override only when needed, e.g.:
#   CRAWLER_MAX_WORKERS=8
#   CRAWLER_INTERVAL_HOURS=2

# Layer 1: kafka-python KafkaProducer durability / internal retry
# CRAWLER_KAFKA_PRODUCER_RETRIES=5              # library retries before failing a send
# CRAWLER_KAFKA_PRODUCER_RETRY_BACKOFF_MS=500   # ms between library retries
# CRAWLER_KAFKA_PRODUCER_ACKS=all               # wait for all in-sync replicas
# CRAWLER_KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true  # dedupe library-internal retries
# CRAWLER_KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000  # per-request broker timeout
# CRAWLER_KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=15000 # total time budget including retries

# Layer 2: application-level send retry (after producer-internal retries fail)
# CRAWLER_KAFKA_SEND_RETRY_MAX_ATTEMPTS=3           # extra app-level retries
# CRAWLER_KAFKA_SEND_RETRY_BASE_DELAY_SECONDS=5.0   # exponential backoff base
