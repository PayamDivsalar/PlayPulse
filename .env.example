# Used by `docker compose` for ${VAR} substitution in docker-compose.yml only
# (credentials and published ports that are the same in every environment).
#
# Do NOT put crawler/app_api runtime hostnames here:
#   - Host venv: crawler/.env and app_api/.env (localhost / 127.0.0.1)
#   - Containers: docker-compose.yml `environment:` (kafka, postgres, app-api, ...)
# See docs/setup.md.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

APP_API_PORT=8000

KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080
METABASE_PORT=3000

# Optional: crawl+persist cycle reports (default off).
# Enable with: ./scripts/bring_up.sh --with-cycle-reports
# CRAWLER_CYCLE_REPORTS_ENABLED=false
# CRAWLER_CYCLE_REPORTS_DIR=/data/reports
