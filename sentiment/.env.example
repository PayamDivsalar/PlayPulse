# Local venv / host-side sentiment job only (NOT used by docker-compose for
# the sentiment container). Inside Docker, connection hosts are set in
# docker-compose.yml `environment:` because hostnames differ.
# See docs/setup.md.

POSTGRES_DB=project_db
POSTGRES_USER=project_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional tunables (defaults live in sentiment/config.py).
# SENTIMENT_MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
# SENTIMENT_BATCH_SIZE=100
# SENTIMENT_DB_CONNECT_TIMEOUT_SECONDS=10
# SENTIMENT_DB_STATEMENT_TIMEOUT_MS=30000
# SENTIMENT_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
