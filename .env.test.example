# Used by scripts/run_tests_in_docker.sh (via --env-file) for ${VAR}
# substitution in docker-compose.yml. Never used by bring_up / Ansible /
# the live stack — those use the root .env.
#
# Copy to .env.test and fill in (or keep these local-only defaults):
#   cp .env.test.example .env.test
#
# Isolation comes from COMPOSE_PROJECT_NAME=playpulse_test (separate volumes
# and network). Credentials here only need to be consistent within the test
# stack; they do not have to match production.
#
# Host ports below are unused while docker-compose.test.yml is applied
# (published ports are cleared). Kept so the file stays a valid mirror of
# .env.example if you ever inspect compose without the override.

POSTGRES_DB=playpulse_test
POSTGRES_USER=playpulse_test
POSTGRES_PASSWORD=playpulse_test
POSTGRES_PORT=5432

APP_API_PORT=8000

KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080
METABASE_PORT=3000

# Optional; defaults match the live stack.
# CRAWLER_CYCLE_REPORTS_ENABLED=false
# CRAWLER_CYCLE_REPORTS_DIR=/data/reports
