# Local venv / host-side storage consumer only (NOT used by docker-compose for
# the storage-consumer container). Inside Docker, connection hosts are set in
# docker-compose.yml `environment:` because hostnames differ.
# See docs/setup.md.

# Required connection settings for host/venv runs.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Same variable names as .env.example and app_api/.env.example on purpose:
# this subsystem writes to the database Django owns the applications table in.
# Use 127.0.0.1 from the host; the container uses `postgres`.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional tunables default inside ``Settings`` / ``load_settings()``
# (storage_consumer/config.py). Override only when needed.

# Which pipelines this process runs. Comma-separated names or `all`. Equivalent
# to --pipeline; running three single-pipeline containers instead of one
# three-threaded container is a deployment choice, not a code change.
# STORAGE_PIPELINES=all

# Consumer groups are named <prefix>.<pipeline>, e.g. storage-consumer.reviews.
# Changing the prefix starts every pipeline over from auto_offset_reset.
# STORAGE_CONSUMER_GROUP_PREFIX=storage-consumer

# Kafka consumer
# STORAGE_POLL_TIMEOUT_MS=1000        # how long an empty poll blocks
#
# Batch size (max records per poll). Resolution is most-specific first:
#   1. STORAGE_MAX_POLL_RECORDS_<PIPELINE>   (per topic)
#   2. STORAGE_MAX_POLL_RECORDS              (global, only if that topic is unset)
#   3. code defaults in pipelines.py         (app-stats=200, reviews=500,
#                                            network-metrics=50)
#
# Raise reviews alone without touching the latency-tuned network-metrics size:
#   STORAGE_MAX_POLL_RECORDS_REVIEWS=1000
# STORAGE_MAX_POLL_RECORDS=
# STORAGE_MAX_POLL_RECORDS_APP_STATS=
# STORAGE_MAX_POLL_RECORDS_REVIEWS=
# STORAGE_MAX_POLL_RECORDS_NETWORK_METRICS=
# STORAGE_MAX_POLL_INTERVAL_MS=300000 # must exceed worst-case batch + DB retries
# STORAGE_SESSION_TIMEOUT_MS=45000    # broker evicts us after this much silence
# STORAGE_HEARTBEAT_INTERVAL_MS=3000  # must be < session timeout
# STORAGE_AUTO_OFFSET_RESET=earliest  # a storage subsystem must not skip history

# PostgreSQL
# STORAGE_DB_CONNECT_TIMEOUT_SECONDS=10
# STORAGE_DB_RETRY_MAX_ATTEMPTS=5              # transient-error retries per batch
# STORAGE_DB_RETRY_BASE_DELAY_SECONDS=1.0      # exponential backoff base
# STORAGE_DB_STATEMENT_TIMEOUT_MS=30000        # a hung write cannot pin a pipeline
# STORAGE_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# package_name -> application_id resolution
# STORAGE_APPLICATION_CACHE_TTL_SECONDS=300.0  # per-thread cache, no locking

# Shutdown and liveness
# STORAGE_SHUTDOWN_TIMEOUT_SECONDS=30.0        # per-thread join budget on SIGTERM
# STORAGE_HEARTBEAT_DIRECTORY=/tmp/storage-consumer
# STORAGE_HEARTBEAT_INTERVAL_SECONDS=10.0      # how often a worker touches its file

# Container-only, read by the shell scripts rather than config.py. Listed here
# so every knob is in one place.
#
# healthcheck.sh: how stale a heartbeat may be before the container is called
# unhealthy. Must exceed one poll timeout plus a full batch including its
# database retry budget, or a container merely waiting for Postgres to come
# back gets restarted -- which is when losing the consumer helps least.
# STORAGE_HEARTBEAT_MAX_AGE_SECONDS=120
#
# docker-entrypoint.sh: how long to wait for Postgres before giving up and
# letting the container restart. A backstop for the gap compose's
# service_healthy leaves, namely Postgres replaying WAL after an unclean stop.
# STORAGE_PG_WAIT_TIMEOUT_SECONDS=60
