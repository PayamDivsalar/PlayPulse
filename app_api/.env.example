# Local venv / host-side App API only.
# When Django runs on the host against compose Postgres, use 127.0.0.1
# (not the docker service name `postgres`). See docs/setup.md.
#
# The Compose `app-api` service does NOT read this file; it gets POSTGRES_*
# from docker-compose.yml `environment:` (POSTGRES_HOST=postgres).

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional Django overrides (defaults match local/dev):
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,host.docker.internal,app-api
