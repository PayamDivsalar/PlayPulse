{{ ansible_managed | comment }}
# Rendered by Ansible from ansible/templates/env.j2 — do not edit by hand.
# Mirrors the project root .env.example. Secret values come from
# ansible-vault (group_vars/vault.yml); ports come from group_vars/all.yml.
#
# Used by `docker compose` for ${VAR} substitution in docker-compose.yml only
# (credentials and published ports that are the same in every environment).

POSTGRES_DB={{ vault_postgres_db }}
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_PORT={{ postgres_port }}

APP_API_PORT={{ app_api_port }}

KAFKA_EXTERNAL_PORT={{ kafka_external_port }}
KAFKA_UI_PORT={{ kafka_ui_port }}
METABASE_PORT={{ metabase_port }}

# Optional: crawl+persist cycle reports (default off).
# Toggle with crawler_cycle_reports_enabled in group_vars/all.yml.
CRAWLER_CYCLE_REPORTS_ENABLED={{ 'true' if crawler_cycle_reports_enabled else 'false' }}
CRAWLER_CYCLE_REPORTS_DIR={{ crawler_cycle_reports_dir }}
