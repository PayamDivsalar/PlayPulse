# Local venv / host-side network analyzer only (NOT used by docker-compose for
# the network-analyzer container). Inside Docker, connection hosts are set in
# docker-compose.yml `environment:` because hostnames differ.
# See docs/setup.md.

# Required connection settings for host/venv runs:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_API_BASE_URL=http://127.0.0.1:8000

# Neither is needed when running fully offline, i.e. with both
#   --dry-run --skip-registry-check
# which contacts no broker and no registry.

# Optional tunables default inside ``Settings`` / ``load_settings()``
# (network_analyzer/config.py). Override only when needed.

# App API eligibility check
# ANALYZER_REGISTRY_REQUEST_TIMEOUT_SECONDS=10.0  # per-request HTTP timeout
# ANALYZER_RETRY_MAX_ATTEMPTS=3                   # retries on network errors
# ANALYZER_RETRY_BASE_DELAY_SECONDS=2.0           # exponential backoff base

# Layer 1: kafka-python KafkaProducer durability / internal retry
# ANALYZER_KAFKA_PRODUCER_RETRIES=5               # library retries before failing a send
# ANALYZER_KAFKA_PRODUCER_RETRY_BACKOFF_MS=500    # ms between library retries
# ANALYZER_KAFKA_PRODUCER_ACKS=all                # wait for all in-sync replicas
# ANALYZER_KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true # dedupe library-internal retries
# ANALYZER_KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000    # per-request broker timeout
# ANALYZER_KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=15000  # total budget including retries

# Layer 2: application-level send retry (after producer-internal retries fail)
# ANALYZER_KAFKA_SEND_RETRY_MAX_ATTEMPTS=3          # extra app-level retries
# ANALYZER_KAFKA_SEND_RETRY_BASE_DELAY_SECONDS=5.0  # exponential backoff base
